<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description }}">
    <meta name="robots" content="index, follow">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="css/style.css">
    <link rel="icon" type="image/png" href="img/logo.png">
  </head>
  <body>
    {% include "menu.njk" %}
    <main id="main-content" class="{% if isHome %}home-page{% else %}inner-page{% endif %}">
      {% if isHome %}
        {{ content | safe }}
      {% else %}
        <article class="page-body">{{ content | safe }}</article>
      {% endif %}
    </main>
    <button id="upArrow" type="button" aria-label="Torna all'inizio" hidden>
      <img src="img/upArrow.svg" alt="">
    </button>
    {% include "footer.njk" %}
    <script defer src="js/site.js"></script>
  </body>
</html>
