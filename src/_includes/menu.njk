<a class="skip-link" href="#main-content">Vai al contenuto</a>
<header class="site-header">
  <a class="site-brand" href="index.html" aria-label="Kawa, homepage">
    <img src="img/logo.png" alt="" aria-hidden="true">
    <span>KAWA</span>
  </a>
  <button class="menu" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="site-navigation">
    <span class="line line1"></span>
    <span class="line line2"></span>
    <span class="line line3"></span>
  </button>
  <nav id="site-navigation" class="site-nav" aria-label="Navigazione principale">
    {% for item in navigation %}
      <a class="nav-link{% if page.fileSlug == item.slug %} current-page{% endif %}"
         href="{{ item.href }}"{% if page.fileSlug == item.slug %} aria-current="page"{% endif %}>
        {{ item.label }}
      </a>
    {% endfor %}
  </nav>
</header>
